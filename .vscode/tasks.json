{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Ver página en vivo",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/start.ps1", "-OpenBrowser"],
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Compilar cambios JSX",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/start.ps1", "-Build"],
      "problemMatcher": []
    }
  ]
}
